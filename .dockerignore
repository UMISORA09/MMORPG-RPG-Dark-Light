# ==============================================================================
# .dockerignore for Chiến Long Bá Monorepo
# Optimizes Docker build context transfer & excludes local dependencies/caches
# ==============================================================================

# VCS & IDE Metadata
.git
.gitignore
.agents
.vscode
.idea
.work

# Dependencies & Package Manager caches
node_modules
.pnpm-store
.pnpm-workspace-state-v1.json

# Local build artifacts & compilation caches
dist
build
out-tsc
tmp
*.tsbuildinfo
.cache
.vercel

# Environment variables & secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Heavy local assets & secondary repositories (Not required inside Docker images)
raw_ai_sprites
bonfire-develop
outputs
tools
docs
taonhanvat.md
header-banner.png
Dragon-Game-Studio
Heroic-Battleground

# Local Windows batch & shell helper scripts
*.bat
*.ps1
